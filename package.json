{
  "name": "@obviyus/better-prompt",
  "version": "0.2.3",
  "description": "OpenClaw plugin: /better from pi-better. Deepens a prompt on a read-only copy of the chat and puts it in the composer.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/obviyus/openclaw-better-prompt"
  },
  "files": [
    "dist",
    "helper.md",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "LICENSE.pi-better"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --external:openclaw --external:'openclaw/*' && openclaw plugins build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test src/better.test.ts src/progress.test.ts src/refusal.test.ts",
    "test:runtime": "TSX_TSCONFIG_PATH=\"${OPENCLAW_SOURCE:?set OPENCLAW_SOURCE to an OpenClaw checkout}/tsconfig.json\" \"$OPENCLAW_SOURCE/node_modules/.bin/tsx\" --test src/index.test.ts src/scoped-composer.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "typebox": "^1.3.17",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.11"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.11.11"
    },
    "build": {
      "openclawVersion": "2026.11.6",
      "bundledDist": false
    }
  }
}
